# 复制成项目根目录的 `.env.local`（注意是根目录，不是 server/），再填上真实值。
# .env.local 已经在 .gitignore 里，不会被提交。

# OpenAI 兼容接口的地址（通常以 /v1 结尾）
# DeepSeek:  https://api.deepseek.com/v1
# OpenAI:    https://api.openai.com/v1
# Moonshot:  https://api.moonshot.cn/v1
# 本地 Ollama: http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（会变，用 GET {baseURL}/models 查当前可用的）
# DeepSeek 目前是 deepseek-flash（便宜）/ deepseek-v4-pro
LLM_MODEL=deepseek-flash

# 服务端持有的密钥。填了它，同学打开网页就能直接玩，不需要自己申请。
LLM_API_KEY=

# 服务端口
PORT=8787
